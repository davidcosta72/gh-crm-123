# CRM-123 Ventas — variables de entorno (Hito 2, ver BUILD_PLAN.md)
# Copia este archivo a .env.local y rellena los valores reales.
# GOOGLE_CLIENT_ID / GOOGLE_CLIENT_SECRET NO van aquí: se configuran
# directamente en el panel de Supabase (Authentication > Providers > Google).

# Panel de Supabase > proyecto dbcrm123 > Settings > API > "Project URL"
NEXT_PUBLIC_SUPABASE_URL=

# Mismo panel > API > "anon public" key
NEXT_PUBLIC_SUPABASE_ANON_KEY=
